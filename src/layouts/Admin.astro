---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE } from '../i18n/site';

interface Props {
  title: string;
  current?: 'applications' | 'contacts' | 'jobs';
  /** false on the login page: no navigation */
  nav?: boolean;
}
const { title, current, nav = true } = Astro.props;

// Internal pages: never cached, never indexed.
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Referrer-Policy', 'same-origin');
Astro.response.headers.set('X-Frame-Options', 'DENY');

const links = [
  { key: 'applications', href: '/admin/', label: 'Candidatures' },
  { key: 'contacts', href: '/admin/contacts/', label: 'Demandes de contact' },
  { key: 'jobs', href: '/admin/jobs/', label: "Offres d'emploi" },
] as const;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Administration {SITE.brand}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-mist">
    <header class="border-b border-line bg-white">
      <div class="container-page flex min-h-16 flex-wrap items-center justify-between gap-3 py-3">
        <a href="/admin/" class="flex items-center gap-3 text-[#012243]">
          <Logo label={SITE.brand} class="h-9 w-auto" />
          <span class="rounded-full bg-ink px-2.5 py-0.5 text-xs font-semibold text-white">Administration</span>
        </a>
        {
          nav && (
            <nav class="flex flex-wrap items-center gap-1" aria-label="Administration">
              {links.map((l) => (
                <a
                  href={l.href}
                  aria-current={current === l.key ? 'page' : undefined}
                  class="rounded-full px-3 py-2 text-sm text-ink/75 hover:bg-mist aria-[current=page]:bg-mist aria-[current=page]:font-semibold aria-[current=page]:text-brand"
                >
                  {l.label}
                </a>
              ))}
              <a href="/fr/" class="rounded-full px-3 py-2 text-sm text-ink/75 hover:bg-mist">Voir le site ↗</a>
              <form method="post" action="/admin/login/">
                <input type="hidden" name="intent" value="logout" />
                <button class="btn-ghost px-4! py-2!">Se déconnecter</button>
              </form>
            </nav>
          )
        }
      </div>
    </header>
    <main class="container-page py-10">
      <slot />
    </main>
  </body>
</html>
