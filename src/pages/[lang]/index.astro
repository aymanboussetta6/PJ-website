---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import HeroArt from '../../components/HeroArt.astro';
import { photo } from '../../lib/photos';
import { ACTIVITY_KEYS, LOCALE_KEYS, getDictionary, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALE_KEYS.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = getDictionary(locale);
const hasHeroPhoto = Boolean(photo('hero'));

// Simple line icons (24×24, stroke) for each activity.
const ICONS: Record<(typeof ACTIVITY_KEYS)[number], string> = {
  studies: 'M4 20h16M6 16l4-10 4 6 2-3 2 7M4 4h6',
  infra: 'M12 2v20M8 22l4-14 4 14M9 12h6M7 6l5-4 5 4',
  radio: 'M12 12v10M8.5 8.5a5 5 0 0 1 7 0M5.6 5.6a9 9 0 0 1 12.8 0M12 12h.01',
  maintenance: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z',
  fiber: 'M3 12c3-6 6 6 9 0s6 6 9 0M3 6c3-6 6 6 9 0s6 6 9 0M3 18c3-6 6 6 9 0s6 6 9 0',
  civil: 'M3 20h18M5 20V10l7-6 7 6v10M9 20v-6h6v6',
};
const SECTOR_ICONS = [
  'M8 2h8v20H8zM11 18h2', // phone / operators
  'M12 2v20M8 22l4-14 4 14M9 12h6', // tower
  'M5 16V6a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v10M5 16h14M7 20l2-4M17 20l-2-4M8 10h8', // train
  'M3 21h18M5 21V9l7-5 7 5v12M10 21v-5h4v5', // town hall
];
// Bento layout (lg: 4 columns): one large feature card, then regular cards.
const BENTO: Record<(typeof ACTIVITY_KEYS)[number], string> = {
  studies: 'sm:col-span-2 lg:row-span-2',
  infra: '',
  radio: '',
  maintenance: '',
  fiber: '',
  civil: 'sm:col-span-2',
};
const ticker = [...t.hero.badges, ...ACTIVITY_KEYS.map((k) => t.activities.items[k].title)];
---

<Base locale={locale}>
  <!-- Hero: sky gradient, text left, illustration (or photo) right -->
  <section class="sky-gradient relative overflow-hidden">
    <div class="container-page grid items-center gap-10 pt-14 pb-24 sm:pt-20 lg:grid-cols-[1.1fr_1fr] lg:pb-32">
      <div data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-white/70 px-3 py-1 text-xs font-semibold tracking-wide text-brand shadow-sm backdrop-blur">
          <span class="size-2 animate-pulse rounded-full bg-sky"></span>
          {t.hero.eyebrow}
        </p>
        <h1 class="mt-6 text-[2.1rem] leading-[1.1] font-extrabold tracking-tight text-balance sm:text-5xl lg:text-6xl">{t.hero.title}</h1>
        <p class="mt-6 max-w-xl text-lg text-pretty text-ink-soft">{t.hero.subtitle}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={`/${locale}/contact/`} class="btn-light">{t.hero.ctaPrimary} →</a>
          <a href="#activities" class="btn-ghost">{t.hero.ctaSecondary}</a>
        </div>
      </div>
      <div data-reveal style="--reveal-i: 2">
        {
          hasHeroPhoto ? (
            <div class="relative mx-auto max-w-md rotate-2 overflow-hidden rounded-[2.5rem] border-8 border-white/70 shadow-2xl shadow-ink/20">
              <Photo name="hero" alt="" class="aspect-[4/5] w-full" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 90vw" loading="eager" />
            </div>
          ) : (
            <HeroArt items={ACTIVITY_KEYS.map((key) => ({ key, ...t.activities.items[key] }))} hint={t.hero.explore} />
          )
        }
      </div>
    </div>
    <!-- wave into the next section -->
    <svg class="absolute inset-x-0 bottom-0 h-12 w-full text-white sm:h-20" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path fill="currentColor" d="M0 48c180 28 360 32 540 16S900 0 1080 8s300 40 360 48v24H0z" />
    </svg>
  </section>

  <!-- Ticker -->
  <div class="overflow-hidden border-y border-line bg-white py-4" aria-hidden="true">
    <div class="animate-marquee flex w-max gap-10 hover:[animation-play-state:paused]">
      {
        [...ticker, ...ticker].map((item) => (
          <span class="flex items-center gap-10 text-sm font-semibold whitespace-nowrap text-ink/70">
            {item}
            <span class="size-1.5 rounded-full bg-sky" />
          </span>
        ))
      }
    </div>
  </div>

  <!-- Activities: bento grid -->
  <section id="activities" class="py-20 sm:py-28">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow">{t.nav.activities}</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-5xl">{t.activities.title}</h2>
        </div>
        <p class="max-w-md text-lg text-muted">{t.activities.intro}</p>
      </div>

      <div class="mt-12 grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          ACTIVITY_KEYS.map((key, i) => {
            const item = t.activities.items[key];
            const big = key === 'studies';
            return (
              <article
                data-reveal
                style={`--reveal-i: ${i % 4}`}
                class:list={[
                  'spotlight group relative flex flex-col overflow-hidden rounded-[1.75rem] border border-line bg-white transition duration-300 hover:-translate-y-1 hover:border-sky hover:shadow-xl hover:shadow-sky/20',
                  BENTO[key],
                ]}
              >
                {big && (
                  <div class="relative min-h-48 flex-1 overflow-hidden">
                    <Photo name={key} alt={item.title} class="absolute inset-0 size-full transition duration-700 group-hover:scale-105" sizes="(min-width: 1024px) 50vw, 100vw" />
                  </div>
                )}
                <div class:list={['flex flex-col p-6', big ? 'sm:p-8' : 'flex-1']}>
                  <span class="grid size-12 place-items-center rounded-2xl bg-mist text-brand transition group-hover:bg-sky group-hover:text-ink">
                    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={ICONS[key]} />
                    </svg>
                  </span>
                  <h3 class:list={['mt-5 font-semibold', big ? 'text-2xl' : 'text-lg']}>{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
                </div>
              </article>
            );
          })
        }
        <!-- CTA tile completes the grid -->
        <a
          href={`/${locale}/contact/`}
          data-reveal
          style="--reveal-i: 2"
          class="group sky-gradient relative flex flex-col justify-between overflow-hidden rounded-[1.75rem] p-6 sm:col-span-2 sm:p-8"
        >
          <h3 class="max-w-xs text-2xl font-bold tracking-tight">{t.contactForm.title}</h3>
          <span class="mt-6 inline-flex items-center gap-2 font-semibold text-ink">
            {t.nav.quote}
            <span class="grid size-9 place-items-center rounded-full bg-white transition group-hover:translate-x-1">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Approach: big outlined numbers -->
  <section id="approach" class="bg-mist py-20 sm:py-28">
    <div class="container-page">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{t.nav.approach}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-5xl">{t.approach.title}</h2>
        <p class="mt-4 text-lg text-muted">{t.approach.intro}</p>
      </div>
      <ol class="mt-14 grid gap-4 md:grid-cols-4">
        {
          t.approach.steps.map((step, i) => (
            <li data-reveal style={`--reveal-i: ${i}`} class="relative overflow-hidden rounded-[1.75rem] bg-white p-6 pt-20 shadow-sm">
              <span class="text-outline absolute -top-3 right-3 text-[6.5rem] leading-none font-black select-none" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="absolute top-6 left-6 h-1.5 w-10 rounded-full bg-sky" aria-hidden="true" />
              <h3 class="relative text-lg font-semibold">{step.title}</h3>
              <p class="relative mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Sectors + commitments -->
  <section id="sectors" class="py-20 sm:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <div data-reveal>
          <p class="eyebrow">{t.nav.sectors}</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-5xl">{t.sectors.title}</h2>
          <p class="mt-4 text-lg text-muted">{t.sectors.intro}</p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            t.sectors.items.map((item, i) => (
              <article data-reveal style={`--reveal-i: ${i}`} class="group rounded-[1.75rem] border border-line p-6 transition hover:border-sky hover:bg-mist">
                <svg class="size-8 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={SECTOR_ICONS[i]} />
                </svg>
                <h3 class="mt-4 font-semibold">{item.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
      <aside data-reveal style="--reveal-i: 2" class="sky-gradient self-start rounded-[2rem] p-8 shadow-xl shadow-sky/20 sm:p-10 lg:sticky lg:top-24">
        <h2 class="text-2xl font-bold">{t.commitments.title}</h2>
        <ul class="mt-6 space-y-5">
          {
            t.commitments.items.map((item) => (
              <li class="flex gap-4">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-white text-brand shadow-sm">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <div>
                  <h3 class="font-semibold">{item.title}</h3>
                  <p class="mt-1 text-sm text-ink-soft">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- Careers teaser -->
  <section class="pb-20 sm:pb-28">
    <div class="container-page">
      <div data-reveal class="grid overflow-hidden rounded-[2rem] bg-ink text-white lg:grid-cols-2">
        <div class="relative min-h-56">
          <Photo name="careers" alt="" class="absolute inset-0 size-full" sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <div class="p-8 sm:p-12">
          <p class="text-xs font-semibold tracking-[0.18em] text-sky uppercase">{t.nav.careers}</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance">{t.careers.title}</h2>
          <p class="mt-4 text-white/80">{t.careers.intro}</p>
          <a href={`/${locale}/careers/`} class="btn-primary mt-8">{t.form.title} →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
