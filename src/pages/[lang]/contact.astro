---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SITE } from '../../i18n/site';
import { LOCALE_KEYS, getDictionary, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALE_KEYS.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = getDictionary(locale);
const c = t.contactForm;
---

<Base locale={locale} title={`${t.nav.contact} — {brand}`} description={c.intro}>
  <PageHeader eyebrow={c.eyebrow} title={c.title} intro={c.intro} />

  <section class="py-14 sm:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:items-start">
      <div class="rounded-[2rem] border border-line bg-white p-6 shadow-xl shadow-ink/5 sm:p-10">
        <ContactForm locale={locale} />
      </div>

      <aside class="space-y-4 lg:sticky lg:top-24">
        <div class="rounded-[2rem] bg-mist p-6">
          <p class="text-sm text-muted">{c.direct}</p>
          <a href={`mailto:${SITE.email}`} class="mt-1 inline-block font-semibold text-brand underline-offset-4 hover:underline">{SITE.email}</a>
        </div>
        <div class="rounded-[2rem] bg-mist p-6">
          <p class="font-semibold">{c.candidate}</p>
          <a href={`/${locale}/careers/`} class="mt-1 inline-block text-sm text-brand underline underline-offset-4">{c.candidateLink} →</a>
        </div>
      </aside>
    </div>
  </section>
</Base>
