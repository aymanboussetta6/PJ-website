---
import Flag from './Flag.astro';
import { LOCALES, LOCALE_KEYS, getDictionary, switchLocalePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const path = Astro.url.pathname;
---

<details class="group relative">
  <summary
    class="flex cursor-pointer list-none items-center gap-2 rounded-full px-3 py-2 text-sm font-medium text-ink transition hover:bg-mist [&::-webkit-details-marker]:hidden"
    aria-label={`${t.nav.language} : ${LOCALES[locale].label}`}
  >
    <Flag code={LOCALES[locale].flag} />
    {LOCALES[locale].short}
    <svg class="size-3 transition group-open:rotate-180" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2 4l4 4 4-4z" /></svg>
  </summary>
  <ul class="absolute right-0 z-50 mt-2 w-60 overflow-hidden rounded-2xl border border-line bg-white p-1.5 shadow-xl">
    {
      LOCALE_KEYS.map((l) => (
        <li>
          <a
            href={switchLocalePath(path, l)}
            hreflang={LOCALES[l].lang}
            lang={LOCALES[l].lang}
            aria-current={l === locale ? 'true' : undefined}
            class:list={['flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-ink hover:bg-mist', l === locale && 'bg-mist font-semibold']}
          >
            <Flag code={LOCALES[l].flag} />
            <span class="flex-1">{LOCALES[l].label}</span>
            {l === locale && (
              <svg class="size-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</details>
