---
import { LOCALES, LOCALE_KEYS, getDictionary, switchLocalePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  dark?: boolean;
}
const { locale, dark = false } = Astro.props;
const t = getDictionary(locale);
const path = Astro.url.pathname;
---

<details class="group relative">
  <summary
    class:list={[
      'flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-2 text-sm font-medium transition [&::-webkit-details-marker]:hidden',
      dark ? 'text-white/85 hover:bg-white/10' : 'text-ink hover:bg-mist',
    ]}
    aria-label={t.nav.language}
  >
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
    </svg>
    {LOCALES[locale].short}
    <svg class="size-3 transition group-open:rotate-180" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2 4l4 4 4-4z" /></svg>
  </summary>
  <ul class="absolute right-0 z-50 mt-2 w-56 overflow-hidden rounded-2xl border border-line bg-white py-1.5 shadow-xl">
    {
      LOCALE_KEYS.map((l) => (
        <li>
          <a
            href={switchLocalePath(path, l)}
            hreflang={LOCALES[l].lang}
            lang={LOCALES[l].lang}
            aria-current={l === locale ? 'true' : undefined}
            class:list={[
              'flex items-center justify-between px-4 py-2 text-sm text-ink hover:bg-mist',
              l === locale && 'font-semibold text-brand',
            ]}
          >
            {LOCALES[l].label}
            <span class="text-xs text-muted">{LOCALES[l].short}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>
