---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SITE } from '../i18n/site';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const home = `/${locale}/`;
const path = Astro.url.pathname;
const links = [
  { href: `${home}#activities`, label: t.nav.activities },
  { href: `${home}#approach`, label: t.nav.approach },
  { href: `${home}#sectors`, label: t.nav.sectors },
  { href: `/${locale}/careers/`, label: t.nav.careers },
  { href: `/${locale}/contact/`, label: t.nav.contact },
];
const isCurrent = (href: string) => !href.includes('#') && path === href;
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-white/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <a href={home} class="flex items-center gap-2.5 text-ink" aria-label={`${SITE.brand} — ${t.nav.home}`}>
      <span class="grid size-9 place-items-center rounded-xl bg-sky font-extrabold text-ink">PJ</span>
      <span class="hidden text-sm font-semibold tracking-tight sm:block">{SITE.brand}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
            class="rounded-full px-3 py-2 text-sm text-ink/75 transition hover:bg-mist hover:text-brand aria-[current=page]:bg-mist aria-[current=page]:font-semibold aria-[current=page]:text-brand"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <LanguageSwitcher locale={locale} />
      <a href={`/${locale}/contact/`} class="btn-primary hidden px-4! py-2! sm:inline-flex">{t.nav.quote}</a>

      <details class="group relative lg:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-ink hover:bg-mist [&::-webkit-details-marker]:hidden" aria-label={t.nav.menu}>
          <svg class="size-6 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="hidden size-6 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </summary>
        <nav class="fixed inset-x-0 top-16 border-b border-line bg-white px-4 pt-2 pb-6 shadow-xl" aria-label={t.nav.menu}>
          <ul class="space-y-1">
            {
              links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={isCurrent(l.href) ? 'page' : undefined}
                    class="block rounded-xl px-4 py-3 font-medium text-ink hover:bg-mist aria-[current=page]:bg-mist aria-[current=page]:text-brand"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href={`/${locale}/contact/`} class="btn-primary mt-4 w-full">{t.nav.quote}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu after choosing an anchor on the same page.
  document.querySelectorAll<HTMLDetailsElement>('header details').forEach((menu) => {
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
  });
</script>
