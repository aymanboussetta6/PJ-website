---
import Logo from './Logo.astro';
import { SITE } from '../i18n/site';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/75">
  <div class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <a href={`/${locale}/`} class="inline-block text-white" aria-label={`${SITE.brand} — ${t.nav.home}`}>
        <Logo label={SITE.brand} class="h-10 w-auto" />
      </a>
      <p class="mt-3 text-sm">{t.footer.tagline}</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <a href={`/${locale}/about/`} class="hover:text-white">{t.nav.founder}</a>
      <a href={`/${locale}/careers/`} class="hover:text-white">{t.nav.careers}</a>
      <a href={`/${locale}/contact/`} class="hover:text-white">{t.nav.contact}</a>
      <a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a>
      <a href={`/${locale}/privacy/`} class="hover:text-white">{t.footer.privacy}</a>
      <span>© {year} {SITE.brand}. {t.footer.rights}</span>
    </div>
  </div>
</footer>
