---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { SITE } from '../i18n/site';
import { countryOptions, DOMAIN_KEYS, getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const f = t.form;
const countries = countryOptions(locale);
const messages = {
  sending: f.sending,
  submit: f.submit,
  success: f.success,
  errorGeneric: f.errorGeneric,
  errorInvalid: f.errorInvalid,
  errorFile: f.errorFile,
  errorCaptcha: f.errorCaptcha,
};
---

<form id="apply-form" class="grid gap-5 sm:grid-cols-2" enctype="multipart/form-data" novalidate data-messages={JSON.stringify(messages)}>
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="jobId" value="" />
  <p id="apply-job" class="hidden items-center justify-between gap-3 rounded-xl bg-sky-soft/60 px-4 py-3 text-sm sm:col-span-2">
    <span>{t.careers.offersApplying} <strong data-job-title></strong></span>
    <button type="button" data-job-clear class="shrink-0 text-brand underline">{t.careers.offersClear}</button>
  </p>
  <div class="hidden" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div>
    <label class="field-label" for="firstName">{f.firstName} *</label>
    <input class="field" id="firstName" name="firstName" required maxlength="80" autocomplete="given-name" />
  </div>
  <div>
    <label class="field-label" for="lastName">{f.lastName} *</label>
    <input class="field" id="lastName" name="lastName" required maxlength="80" autocomplete="family-name" />
  </div>
  <div>
    <label class="field-label" for="email">{f.email} *</label>
    <input class="field" id="email" name="email" type="email" required maxlength="200" autocomplete="email" />
  </div>
  <div>
    <label class="field-label" for="phone">{f.phone} *</label>
    <input class="field" id="phone" name="phone" type="tel" required maxlength="30" autocomplete="tel" placeholder="+381 …" />
  </div>
  <div>
    <label class="field-label" for="country">{f.country} *</label>
    <select class="field" id="country" name="country" required>
      <option value="">{f.countryPlaceholder}</option>
      {countries.map((c) => <option value={c.code}>{c.name}</option>)}
      <option value="OTHER">{f.otherCountry}</option>
    </select>
  </div>
  <div>
    <label class="field-label" for="domain">{f.domain} *</label>
    <select class="field" id="domain" name="domain" required>
      <option value="">{f.domainPlaceholder}</option>
      {DOMAIN_KEYS.map((d) => <option value={d}>{f.domains[d]}</option>)}
    </select>
  </div>
  <div class="sm:col-span-2">
    <label class="field-label" for="languages">{f.languages} *</label>
    <input class="field" id="languages" name="languages" required maxlength="200" placeholder={f.languagesHint} />
  </div>
  <div class="sm:col-span-2">
    <label class="field-label" for="message">{f.message}</label>
    <textarea class="field min-h-28" id="message" name="message" maxlength="2000" rows="4"></textarea>
  </div>
  <div class="sm:col-span-2">
    <label class="field-label" for="cv">{f.cv} *</label>
    <input
      class="field cursor-pointer file:mr-4 file:rounded-full file:border-0 file:bg-brand/10 file:px-4 file:py-1.5 file:text-sm file:font-semibold file:text-brand"
      id="cv"
      name="cv"
      type="file"
      required
      accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      aria-describedby="cv-hint"
    />
    <p id="cv-hint" class="mt-1.5 text-xs text-muted">{f.cvHint}</p>
  </div>
  <div class="sm:col-span-2">
    <label class="flex items-start gap-3 text-sm text-muted">
      <input type="checkbox" name="consent" required class="mt-0.5 size-4 shrink-0 accent-brand" />
      <span>
        {f.consent}{" "}
        <a href={`/${locale}/privacy/`} class="font-medium text-brand underline-offset-2 hover:underline">{f.privacyLink}</a>
      </span>
    </label>
  </div>

  {PUBLIC_TURNSTILE_SITE_KEY && <div class="cf-turnstile sm:col-span-2" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} />}

  <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center">
    <button type="submit" class="btn-primary disabled:cursor-wait disabled:opacity-60">{f.submit}</button>
    <p class="text-xs text-muted">{f.intro} · <a href={`mailto:${SITE.recruitingEmail}`} class="underline">{SITE.recruitingEmail}</a></p>
  </div>
  <p id="apply-status" role="status" aria-live="polite" class="hidden rounded-xl px-4 py-3 text-sm sm:col-span-2"></p>
</form>

<script>
  import { actions } from 'astro:actions';
  import { enhanceForm } from '../lib/form-client';

  const form = document.querySelector<HTMLFormElement>('#apply-form');
  if (form) {
    enhanceForm(form, (data) => actions.apply(data), {
      name: 'cv',
      required: true,
      maxBytes: 5 * 1024 * 1024,
      pattern: /\.(pdf|docx?)$/i,
    });
  }
</script>

<style>
  [aria-invalid='true'] {
    border-color: rgb(220 38 38);
  }
</style>
