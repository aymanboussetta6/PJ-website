---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-dark via-brand to-sky-deep text-white">
  <div aria-hidden="true" class="absolute -top-32 -right-24 size-96 rounded-full bg-white/15 blur-3xl"></div>
  <div class="container-page relative py-14 sm:py-20">
    <p class="text-xs font-semibold tracking-[0.18em] text-sky-light uppercase">{eyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-balance sm:text-5xl">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-lg text-pretty text-white/90">{intro}</p>}
  </div>
</section>
