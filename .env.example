# URL publique du site (balises canonical / hreflang)
SITE_URL=https://pj-telecom.com

# Supabase (projet en région UE, ex. Francfort) — clé service_role : SECRÈTE, serveur uniquement
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CV_BUCKET=cvs
SUPABASE_CONTACT_BUCKET=contact-files

# Resend (e-mails)
RESEND_API_KEY=
# Adresse d'envoi : le domaine pj-telecom.com doit être vérifié dans Resend
MAIL_FROM="PJ Telecom <noreply@pj-telecom.com>"
MAIL_TO_RECRUITING=admin@pj-telecom.com
# Destinataire des demandes clients / sous-traitants / fournisseurs (défaut : MAIL_TO_RECRUITING)
MAIL_TO_CONTACT=admin@pj-telecom.com

# Cloudflare Turnstile (anti-spam). Laisser vide pour désactiver.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
