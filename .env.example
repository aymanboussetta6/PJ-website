# URL publique du site (balises canonical / hreflang)
SITE_URL=https://example.com

# Supabase (projet en région UE, ex. Francfort) — clé service_role : SECRÈTE, serveur uniquement
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CV_BUCKET=cvs

# Resend (e-mails)
RESEND_API_KEY=
MAIL_FROM="PJ Telecom Talent <noreply@example.com>"
MAIL_TO_RECRUITING=jobs@example.com

# Cloudflare Turnstile (anti-spam). Laisser vide pour désactiver.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
